# App
DEBUG=false
APP_PORT=8000

# Database
# For local dev against docker compose, use DB_PORT=3307 — the db container publishes
# 127.0.0.1:3307 so it can't collide with a local MySQL/MariaDB on 3306. In production
# (or inside the compose network) this is 3306.
DB_HOST=localhost
DB_PORT=3306
DB_USER=imageopt
DB_PASSWORD=your_secure_password
DB_NAME=imageopt
DB_ROOT_PASSWORD=your_root_password

# Redis
REDIS_URL=redis://localhost:6379/0

# Storage
UPLOAD_DIR=uploads
PROCESSED_DIR=processed
MAX_FILE_SIZE_MB=50

# Auto-delete undownloaded files after N hours
AUTO_DELETE_HOURS=24

# Image quality (1-95)
DEFAULT_QUALITY=85

# Video — separate limits from images/PDFs (2 GB default)
MAX_VIDEO_SIZE_MB=2048
MAX_VIDEO_FILES=5
# Hard ceiling on one encode; ffmpeg is killed past this and the job is marked failed
VIDEO_TIME_LIMIT_SECONDS=7200
# CPU threads ffmpeg may use per encode
FFMPEG_THREADS=2

# Video compression requires ffmpeg + ffprobe on PATH — there is no fallback encoder.
# The Docker image installs ffmpeg; on bare-metal run `apt-get install ffmpeg`.
# Without it, /video/upload returns 503.

# PDF compression uses Ghostscript when the `gs` binary is on PATH (best results —
# downsamples embedded images per preset). Without it, pikepdf does lossless
# structural compression only. The Docker image installs ghostscript automatically.

# CORS — comma-separated list of allowed origins (set to your Vercel URL in production)
CORS_ORIGINS=["https://your-app.vercel.app"]
