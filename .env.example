# App
DEBUG=false
APP_PORT=8000

# Database
# For local dev against docker compose, use DB_PORT=3307 — the db container publishes
# 127.0.0.1:3307 so it can't collide with a local MySQL/MariaDB on 3306. In production
# (or inside the compose network) this is 3306.
DB_HOST=localhost
DB_PORT=3306
DB_USER=imageopt
DB_PASSWORD=your_secure_password
DB_NAME=imageopt
DB_ROOT_PASSWORD=your_root_password

# Redis
REDIS_URL=redis://localhost:6379/0

# Storage
UPLOAD_DIR=uploads
PROCESSED_DIR=processed
MAX_FILE_SIZE_MB=50

# Auto-delete undownloaded files after N hours
AUTO_DELETE_HOURS=24

# Image quality (1-95)
DEFAULT_QUALITY=85

# Video — separate limits from images/PDFs (2 GB default)
MAX_VIDEO_SIZE_MB=2048
MAX_VIDEO_FILES=5
# Hard ceiling on one encode; ffmpeg is killed past this and the job is marked failed
VIDEO_TIME_LIMIT_SECONDS=7200
# CPU threads ffmpeg may use per encode
FFMPEG_THREADS=2

# Video compression requires ffmpeg + ffprobe on PATH — there is no fallback encoder.
# The Docker image installs ffmpeg; on bare-metal run `apt-get install ffmpeg`.
# Without it, /video/upload returns 503.

# PDF compression uses Ghostscript when the `gs` binary is on PATH (best results —
# downsamples embedded images per preset). Without it, pikepdf does lossless
# structural compression only. The Docker image installs ghostscript automatically.

# Downloaded files stay available this many minutes (dropped connections, browser
# retries), then the cleanup task deletes them
DOWNLOAD_GRACE_MINUTES=30

# Uploads get 503 once this many jobs are queued, or when free disk drops below this
MAX_QUEUED_JOBS=200
MAX_QUEUED_VIDEOS=20
MIN_FREE_DISK_MB=5120

# ---- Google sign-in (required; the API won't start without it) ----
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web app).
# Add AUTH_REDIRECT_URL as an authorized redirect URI on that client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_REDIRECT_URL=https://api.example.com/auth/callback
FRONTEND_URL=https://app.example.com
# 32+ random characters: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# Parent domain shared by the frontend, API and upload hosts. Leave empty for localhost.
SESSION_COOKIE_DOMAIN=.example.com
SESSION_MAX_AGE_HOURS=12
# Google Workspace domains allowed in (JSON list). Personal Gmail accounts never are.
ALLOWED_DOMAINS=["example.com"]
# These accounts can list every user's jobs (GET /*/jobs?all=true)
ADMIN_EMAILS=[]
# Local dev only: skip sign-in (only honoured when DEBUG=true)
AUTH_DISABLED=false

# CORS — allowed frontend origins (JSON list). '*' is refused while auth is on.
CORS_ORIGINS=["https://app.example.com"]
